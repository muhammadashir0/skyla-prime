# SKYLA PRIME — copy to .env and fill in. Never commit real keys.
#
# --- Authentication (v0.2.0) -------------------------------------------------
# Recommended: create real users. The bootstrap admin is created on first start
# from SKYLA_ADMIN_PASSWORD; if unset, a one-time credential is written to
# data/bootstrap_admin_credential.txt (mode 0600, delete after first login).
SKYLA_ADMIN_USER=admin
SKYLA_ADMIN_PASSWORD=
# Legacy single shared token -> maps to an admin principal. Leave EMPTY for
# deployments that use real users; production must retire it.
SKYLA_API_TOKEN=
SKYLA_MAX_AUTONOMY=2

# --- Storage -----------------------------------------------------------------
# SQLite file path (development default). PostgreSQL is planned, not implemented.
SKYLA_DB_PATH=

# --- Execution isolation (WS1) -----------------------------------------------
# namespace = Linux namespaces + chroot (validated default on this host)
# container = rootless Docker/OCI (auto-disabled when no daemon is reachable)
# restricted = DEVELOPMENT ONLY, NOT a security boundary
# disabled   = run no code at all (fail-closed)
SKYLA_EXECUTION_PROVIDER=namespace

# Model providers (any one enables live intelligence; mock is default)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
DEEPSEEK_API_KEY=
QWEN_API_KEY=
GLM_API_KEY=
SKYLA_CUSTOM_BASE_URL=
SKYLA_CUSTOM_MODEL=

# Connectors
TELEGRAM_BOT_TOKEN=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
